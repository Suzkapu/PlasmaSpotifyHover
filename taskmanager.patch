diff --git a/applets/taskmanager/qml/ToolTipInstance.qml b/applets/taskmanager/qml/ToolTipInstance.qml
index 7c5f245..e0397a7 100644
--- a/applets/taskmanager/qml/ToolTipInstance.qml
+++ b/applets/taskmanager/qml/ToolTipInstance.qml
@@ -377,6 +377,102 @@ ColumnLayout {
         source: "PlayerController.qml"
     }
 
+    // Use the player already matched to this task by Plasma.
+    RowLayout {
+        id: spotifyControls
+
+        readonly property var player: playerController.active ? toolTipDelegate.playerData : null
+        readonly property string entry: player?.desktopEntry?.toLowerCase() ?? ""
+        readonly property bool isSpotify: ["spotify", "spotify.desktop", "com.spotify.client",
+                                            "com.spotify.client.desktop"].includes(entry)
+        readonly property bool canSeek: isSpotify && (player?.canSeek ?? false) && player.length > 0
+        readonly property string track: player?.track ?? ""
+        readonly property string artist: player?.artist ?? ""
+        property int trackRevision: 0
+        onTrackChanged: ++trackRevision
+        onArtistChanged: ++trackRevision
+        onPlayerChanged: ++trackRevision
+
+        visible: isSpotify
+        Layout.fillWidth: true
+        Layout.maximumWidth: headerItem.Layout.maximumWidth
+        Layout.leftMargin: headerItem.Layout.margins
+        Layout.rightMargin: headerItem.Layout.margins
+
+        Timer {
+            interval: 1000
+            repeat: true
+            running: spotifyControls.visible && spotifyControls.canSeek
+            triggeredOnStart: true
+            onTriggered: spotifyControls.player?.updatePosition()
+        }
+
+        PlasmaComponents3.Slider {
+            id: seekSlider
+
+            property int dragRevision: -1
+
+            visible: spotifyControls.canSeek
+            Layout.fillWidth: true
+            from: 0
+            to: spotifyControls.player?.length ?? 0
+            Accessible.name: i18n("Seek in Spotify track")
+
+            Binding on value {
+                when: seekSlider.dragRevision === -1
+                value: spotifyControls.player?.position ?? 0
+                restoreMode: Binding.RestoreNone
+            }
+
+            onPressedChanged: {
+                if (pressed) {
+                    dragRevision = spotifyControls.trackRevision;
+                } else {
+                    if (dragRevision === spotifyControls.trackRevision && spotifyControls.canSeek) {
+                        spotifyControls.player.position = Math.round(value);
+                    }
+                    dragRevision = -1;
+                }
+            }
+
+            onMoved: {
+                if (dragRevision === -1 && !pressed && spotifyControls.canSeek) {
+                    spotifyControls.player.position = Math.round(value);
+                }
+            }
+        }
+
+        PlasmaComponents3.Label {
+            visible: seekSlider.visible
+            text: formatTime(seekSlider.value) + " / " + formatTime(seekSlider.to)
+
+            function formatTime(microseconds: real): string {
+                const seconds = Math.max(0, Math.floor(microseconds / 1000000));
+                return Math.floor(seconds / 60) + ":" + String(seconds % 60).padStart(2, "0");
+            }
+        }
+
+        PlasmaComponents3.ToolButton {
+            icon.name: "emblem-favorite-symbolic"
+            enabled: spotifyControls.track.length > 0 && !backend.spotifySaving
+            Accessible.name: i18n("Save to Spotify Liked Songs")
+            PlasmaComponents3.ToolTip.text: Accessible.name
+            PlasmaComponents3.ToolTip.visible: hovered
+            onClicked: backend.saveSpotifyTrack(spotifyControls.track, spotifyControls.artist)
+        }
+    }
+
+    PlasmaComponents3.Label {
+        visible: spotifyControls.visible && backend.spotifyStatus.length > 0
+        text: backend.spotifyStatus
+        textFormat: Text.PlainText
+        wrapMode: Text.WordWrap
+        Layout.fillWidth: true
+        Layout.maximumWidth: headerItem.Layout.maximumWidth
+        Layout.leftMargin: headerItem.Layout.margins
+        Layout.rightMargin: headerItem.Layout.margins
+    }
+
